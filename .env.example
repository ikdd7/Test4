# ====================================================================
#  환경변수 (이 파일을 복사해서 .env.local 로 만들고 값을 채우세요)
#  ✋ 당신이 채워야 하는 값은 여기 한 곳에 모여 있습니다.
# ====================================================================

# [필수] Anthropic Claude API 키 — 당신이 발급할 키는 이것 "하나"뿐입니다.
#  발급: https://console.anthropic.com  →  API Keys  →  Create Key
ANTHROPIC_API_KEY=sk-ant-여기에-붙여넣기

# [필수] 접속 비밀번호 — 당신과 소수만 아는 값으로 자유롭게 정하세요.
APP_PASSWORD=원하는-비밀번호로-바꾸세요

# [선택] 쿠키 서명용 솔트 — 아무 랜덤 문자열. 보안을 위해 바꾸길 권장.
AUTH_SALT=아무-랜덤-문자열-바꾸세요

# [선택] 사용할 Claude 모델 (기본: 정확성 우선 claude-opus-4-8)
#  비용을 낮추려면 claude-sonnet-4-6 또는 claude-haiku-4-5 로 변경 가능.
ANTHROPIC_MODEL=claude-opus-4-8
