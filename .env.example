# ====================================================================
#  환경변수 (이 파일을 복사해서 .env.local 로 만들고 값을 채우세요)
#  ✋ 당신이 채워야 하는 값은 여기 한 곳에 모여 있습니다.
# ====================================================================

# ── LLM 공급자: 아래 중 "하나"만 키를 넣으면 자동 선택됩니다 ──
#  (둘 다 비우면 'API 없이 검색 전용 모드'로 동작 — 원문만 보여줌)

# [옵션 1] Google Gemini — 무료 등급 있음(테스트 추천)
#  발급: https://aistudio.google.com  →  Get API key  (무료)
GEMINI_API_KEY=
#  사용할 모델(키가 지원하는 이름으로). 기본 gemini-2.5-flash
#  안 되면 gemini-2.0-flash / gemini-1.5-flash 로 바꾸세요.
GEMINI_MODEL=gemini-2.5-flash

# [옵션 1-b] OpenRouter(무료) — Gemini 실패 시 1순위 폴백. DeepSeek V3/Qwen 등 강한 무료 모델.
#  한국어 법령 추론이 Groq(llama)보다 나음.  발급: https://openrouter.ai  →  Keys  (무료)
OPENROUTER_API_KEY=
#  사용할 무료 모델(openrouter.ai/models 에서 'free' 필터). 기본 DeepSeek V3.
#  안 되면 qwen/qwen-2.5-72b-instruct:free 등으로 변경.
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# [옵션 1-c] Groq(무료) — 2순위 폴백(빠르지만 한국어 법령 추론은 약함).
#  ⚠ 유료 Grok(xAI)이 아니라 무료 추론 서비스 Groq(q로 끝남)입니다.
#  발급: https://console.groq.com  →  API Keys  (무료)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# [옵션 2] Anthropic Claude — 정확도 최상(에이전틱 검색+검증), 유료
#  발급: https://console.anthropic.com  →  API Keys  →  Create Key
ANTHROPIC_API_KEY=

# [옵션] 공급자 강제 지정: search | llm(=Gemini→Groq) | anthropic (보통 비워두면 자동)
LLM_PROVIDER=

# [필수] 접속 비밀번호 — 당신과 소수만 아는 값으로 자유롭게 정하세요.
APP_PASSWORD=원하는-비밀번호로-바꾸세요

# [선택] 쿠키 서명용 솔트 — 아무 랜덤 문자열. 보안을 위해 바꾸길 권장.
AUTH_SALT=아무-랜덤-문자열-바꾸세요

# [선택] 사용할 Claude 모델 (기본: 최상위 정확성 claude-fable-5)
#  Fable 5 가격: 입력 $10 / 출력 $50 per 1M tokens (Opus 4.8의 약 2배)
#  비용을 낮추려면 claude-opus-4-8 / claude-sonnet-4-6 / claude-haiku-4-5 로 변경 가능.
ANTHROPIC_MODEL=claude-fable-5
